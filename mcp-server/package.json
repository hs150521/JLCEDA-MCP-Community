{
  "name": "jlceda-mcp-server",
  "version": "2.3.0",
  "description": "JLCEDA EDA MCP Server - 嘉立创EDA的Model Context Protocol服务器（支持多客户端）",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "jlceda-mcp": "./dist/index.js"
  },
  "scripts": {
    "sync:contract": "node ../tool/sync-bridge-contract.mjs",
    "build": "npm run sync:contract && npm run clean && tsc && node scripts/copy-resources.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:bridge": "node scripts/bridge-test.mjs",
    "test": "npm run test:routing && npm run build && npm run test:smoke && npm run test:bridge && npm run test:dispatcher",
    "test:routing": "node scripts/verify-tool-routing.mjs",
    "test:dispatcher": "node scripts/tool-dispatcher-test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jlceda",
    "eda",
    "schematic",
    "pcb"
  ],
  "author": "JLCEDA MCP Community <hs150521@proton.me>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hs150521/JLCEDA-MCP-Community",
  "repository": {
    "type": "git",
    "url": "https://github.com/hs150521/JLCEDA-MCP-Community.git",
    "directory": "mcp-server"
  },
  "bugs": "https://github.com/hs150521/JLCEDA-MCP-Community/issues",
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  }
}
