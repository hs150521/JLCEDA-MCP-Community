{
  "name": "jlceda-mcp-server",
  "version": "2.1.1",
  "description": "JLCEDA EDA MCP Server - 嘉立创EDA的Model Context Protocol服务器（支持多客户端）",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "jlceda-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && node scripts/copy-resources.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:bridge": "node scripts/bridge-test.mjs",
    "test": "npm run test:routing && npm run build && npm run test:smoke && npm run test:bridge",
    "test:routing": "node scripts/verify-tool-routing.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jlceda",
    "eda",
    "schematic",
    "pcb"
  ],
  "author": "JLCEDA MCP Community <yuanzl150521@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  }
}
