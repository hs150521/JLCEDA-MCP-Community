{
	"contractVersion": "2.3.0",
	"protocol": {
		"version": 1,
		"clientMessages": {
			"bridge/hello": {
				"required": {
					"clientId": "non-empty-string",
					"bridgeVersion": "non-empty-string"
				},
				"optional": {
					"protocolVersion": "positive-integer",
					"selectionProbeVersion": "positive-integer",
					"context": "context"
				}
			},
			"bridge/heartbeat": {
				"required": {
					"clientId": "non-empty-string",
					"sentAt": "finite-number"
				},
				"optional": {
					"context": "context"
				}
			},
			"bridge/ready": {
				"required": {
					"clientId": "non-empty-string",
					"readyAt": "finite-number"
				}
			},
			"bridge/task-started": {
				"required": {
					"clientId": "non-empty-string",
					"requestId": "non-empty-string",
					"leaseTerm": "non-negative-integer",
					"startedAt": "finite-number"
				},
				"optional": {
					"schematicPinAdapter": "schematic-pin-adapter",
					"context": "context"
				}
			},
			"bridge/result": {
				"required": {
					"clientId": "non-empty-string",
					"requestId": "non-empty-string",
					"leaseTerm": "non-negative-integer"
				},
				"optional": {
					"result": "any",
					"error": "task-error"
				}
			},
			"bridge/log": {
				"required": {
					"clientId": "non-empty-string",
					"log": "record"
				}
			},
			"bridge/probe-ack": {
				"required": {
					"clientId": "non-empty-string",
					"probeId": "non-empty-string"
				}
			}
		},
		"serverMessages": {
			"bridge/welcome": {
				"required": {
					"clientId": "non-empty-string",
					"connectedAt": "non-empty-string"
				},
				"optional": {
					"protocolVersion": "positive-integer"
				}
			},
			"bridge/role": {
				"required": {
					"clientId": "non-empty-string",
					"role": "role",
					"leaseTerm": "non-negative-integer",
					"activeClientId": "string",
					"reason": "string"
				}
			},
			"bridge/debug-switch": {
				"required": {
					"clientId": "non-empty-string",
					"debugSwitch": "debug-switch"
				}
			},
			"bridge/heartbeat-ack": {
				"required": {
					"clientId": "non-empty-string",
					"sentAt": "finite-number",
					"receivedAt": "non-empty-string"
				}
			},
			"bridge/probe": {
				"required": {
					"clientId": "non-empty-string",
					"probeId": "non-empty-string"
				}
			},
			"bridge/task": {
				"required": {
					"requestId": "non-empty-string",
					"path": "bridge-path",
					"payload": "any",
					"createdAt": "finite-number",
					"leaseTerm": "non-negative-integer"
				}
			},
			"bridge/error": {
				"required": {
					"message": "non-empty-string"
				},
				"optional": {
					"requestId": "non-empty-string"
				}
			},
			"bridge/recover": {
				"required": {
					"recoveryId": "non-empty-string",
					"reason": "non-empty-string"
				}
			}
		}
	},
	"timeoutPolicies": {
		"default": {
			"defaultMs": 25000,
			"minMs": 25000,
			"maxMs": 25000,
			"allowOverride": false
		},
		"api": {
			"defaultMs": 15000,
			"minMs": 1000,
			"maxMs": 120000,
			"allowOverride": true
		},
		"standard-read": {
			"defaultMs": 30000,
			"minMs": 5000,
			"maxMs": 120000,
			"allowOverride": true
		},
		"extended-read": {
			"defaultMs": 60000,
			"minMs": 5000,
			"maxMs": 120000,
			"allowOverride": true
		},
		"batch-write": {
			"defaultMs": 300000,
			"minMs": 25000,
			"maxMs": 600000,
			"allowOverride": true
		}
	},
