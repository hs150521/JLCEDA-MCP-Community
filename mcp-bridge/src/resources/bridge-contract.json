{
	"contractVersion": "2.3.0",
	"protocol": {
		"version": 1,
		"clientMessages": {
			"bridge/hello": {
				"required": {
					"clientId": "non-empty-string",
					"bridgeVersion": "non-empty-string"
				},
				"optional": {
					"protocolVersion": "positive-integer",
					"context": "context"
				}
			},
			"bridge/heartbeat": {
				"required": {
					"clientId": "non-empty-string",
					"sentAt": "finite-number"
				},
				"optional": {
					"context": "context"
				}
			},
			"bridge/ready": {
				"required": {
					"clientId": "non-empty-string",
					"readyAt": "finite-number"
				}
			},
			"bridge/task-started": {
				"required": {
					"clientId": "non-empty-string",
					"requestId": "non-empty-string",
					"leaseTerm": "non-negative-integer",
					"startedAt": "finite-number"
				}
			},
			"bridge/result": {
				"required": {
					"clientId": "non-empty-string",
					"requestId": "non-empty-string",
					"leaseTerm": "non-negative-integer"
				},
				"optional": {
					"result": "any",
					"error": "task-error"
				}
			},
			"bridge/log": {
				"required": {
					"clientId": "non-empty-string",
					"log": "record"
				}
			}
		},
		"serverMessages": {
			"bridge/welcome": {
				"required": {
					"clientId": "non-empty-string",
					"connectedAt": "non-empty-string"
				},
				"optional": {
					"protocolVersion": "positive-integer"
				}
			},
			"bridge/role": {
				"required": {
					"clientId": "non-empty-string",
					"role": "role",
					"leaseTerm": "non-negative-integer",
					"activeClientId": "string",
					"reason": "string"
				}
			},
			"bridge/debug-switch": {
				"required": {
					"clientId": "non-empty-string",
					"debugSwitch": "debug-switch"
				}
			},
			"bridge/heartbeat-ack": {
				"required": {
					"clientId": "non-empty-string",
					"sentAt": "finite-number",
					"receivedAt": "non-empty-string"
				}
			},
			"bridge/task": {
				"required": {
					"requestId": "non-empty-string",
					"path": "bridge-path",
					"payload": "any",
					"createdAt": "finite-number",
					"leaseTerm": "non-negative-integer"
				}
			},
			"bridge/error": {
				"required": {
					"message": "non-empty-string"
				},
				"optional": {
					"requestId": "non-empty-string"
				}
			},
			"bridge/recover": {
				"required": {
					"recoveryId": "non-empty-string",
					"reason": "non-empty-string"
				}
			}
		}
	},
	"timeoutPolicies": {
		"default": {
			"defaultMs": 25000,
			"minMs": 25000,
			"maxMs": 25000,
			"allowOverride": false
		},
		"api": {
			"defaultMs": 15000,
			"minMs": 1000,
			"maxMs": 120000,
			"allowOverride": true
		},
		"standard-read": {
			"defaultMs": 30000,
			"minMs": 5000,
			"maxMs": 120000,
			"allowOverride": true
		},
		"extended-read": {
			"defaultMs": 60000,
			"minMs": 5000,
			"maxMs": 120000,
			"allowOverride": true
		}
	},
	"operations": [
		{
			"toolName": "bridge_clients",
			"path": "/bridge/admin/clients",
			"owner": "server"
		},
		{
			"toolName": "bridge_select_client",
			"path": "/bridge/admin/select-client",
			"owner": "server"
		},
		{
			"toolName": "bridge_recover_client",
			"path": "/bridge/admin/recover-client",
			"owner": "server"
		},
		{
			"toolName": "api_index",
			"path": "/bridge/jlceda/api/index",
			"owner": "bridge",
			"timeoutPolicy": "default",
			"readOnly": true
		},
		{
			"toolName": "api_search",
			"path": "/bridge/jlceda/api/search",
			"owner": "bridge",
			"timeoutPolicy": "default",
			"readOnly": true
		},
		{
			"toolName": "api_invoke",
			"path": "/bridge/jlceda/api/invoke",
			"owner": "bridge",
			"timeoutPolicy": "api"
		},
		{
