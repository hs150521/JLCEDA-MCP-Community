{
	"name": "mcp-bridge-community",
	"version": "2.1.3",
	"description": "嘉立创EDA & EasyEDA 专业版扩展 API 开发工具",
	"author": "JLCEDA MCP Community <hs150521@proton.me>",
	"license": "Apache-2.0",
	"homepage": "https://github.com/hs150521/JLCEDA-MCP-Community",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ && ts-node --project tsconfig.build.json ./config/esbuild.prod.ts",
		"typecheck": "tsc --noEmit",
		"verify:api-doc": "node scripts/verify-api-doc.cjs",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run test:netlabel && npm run test:2.1 && npm run typecheck && npm run verify:api-doc && npm run compile && npm run verify:runtime && ts-node --project tsconfig.build.json ./build/packaged.ts",
		"verify:runtime": "node scripts/verify-runtime-entry.mjs",
		"test:netlabel": "node scripts/netlabel-kind-test.cjs",
		"test:2.1": "node scripts/2.1-tools-test.cjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.4.15",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.15.30",
		"@types/react": "^19.2.14",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"lint-staged": "^16.2.3",
		"rimraf": "^6.0.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	}
}
